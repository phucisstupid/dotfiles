#!/bin/sh
set -eu

script_path=$(readlink -f -- "$0")
cd "$(dirname "$script_path")"

export NIX_CONFIG="extra-experimental-features = nix-command flakes${NIX_CONFIG:+
$NIX_CONFIG}"

do_facter() (
  host="${1:-$(hostname -s)}"
  if [ "$(uname)" = "Darwin" ]; then
    echo "facter is only supported on Linux."
    exit 0
  fi
  report="modules/hosts/$host/facter.json"
  if [ -d "$report" ]; then
    printf '%s is a directory.\n' "$report" >&2
    exit 1
  fi
  temp_report=$(mktemp "$report.XXXXXX")
  trap 'rm -f "$temp_report"' EXIT
  # Keep the report caller-owned and replace it only after a successful scan.
  if command -v nixos-facter >/dev/null 2>&1; then
    sudo nixos-facter >"$temp_report"
  else
    sudo nix --extra-experimental-features "nix-command flakes" run nixpkgs#nixos-facter >"$temp_report"
  fi
  mv -f "$temp_report" "$report"
  git add "$report"
)

do_switch() {
  host="${1:-$(hostname -s)}"
  nh="nh"
  if ! command -v nh >/dev/null 2>&1; then
    nh="nix run nixpkgs#nh --"
  fi
  if [ "$(uname)" = "Darwin" ]; then
    $nh darwin switch . -H "$host"
  else
    report="modules/hosts/$host/facter.json"
    if [ ! -f "$report" ] || [ ! -r "$report" ]; then
      do_facter "$host"
    else
      git add "$report"
    fi
    $nh os switch . -H "$host"
  fi

  bin_dir="${HOME:?}/.local/bin"
  mkdir -p "$bin_dir"
  # Pass the parent directory so ln treats an existing dotfiles directory as a collision.
  if [ -L "$bin_dir/dotfiles" ]; then
    if [ "$(readlink "$bin_dir/dotfiles")" != "$script_path" ]; then
      ln -sfn -- "$script_path" "$bin_dir/"
    fi
  else
    ln -s -- "$script_path" "$bin_dir/"
  fi
}

usage() {
  cat <<EOF
Usage: dotfiles <command> [options]

Commands:
  switch           Apply this flake
  update           Pull latest changes and switch
  write-flake      Regenerate flake.nix
  facter           Generate facter.json for the current host (Linux only)
  install-nix      Install Nix with flakes enabled (macOS only)

Options:
  -h, --help       Show this help message
  -H, --host HOST  Target host for switch, update, and facter (defaults to current short hostname)
EOF
}

case "${1:-}" in
switch | update | facter)
  host=""
  if [ "$#" -eq 3 ] && { [ "$2" = -H ] || [ "$2" = --host ]; }; then
    case "$3" in
    "" | -*)
      printf '%s\n' "$2 requires a hostname." >&2
      exit 1
      ;;
    esac
    host="$3"
  elif [ "$#" -ne 1 ]; then
    usage >&2
    exit 1
  fi
  if [ "$1" = facter ]; then
    do_facter "$host"
  else
    if [ "$1" = update ]; then
      git checkout main
      git pull
    fi
    do_switch "$host"
  fi
  ;;
write-flake)
  nix run .#write-flake
  ;;
install-nix)
  if [ "$(uname)" != "Darwin" ]; then
    echo "install-nix is only supported on macOS."
    exit 0
  fi
  if command -v nix >/dev/null 2>&1; then
    echo "Nix is already installed."
  else
    echo "Installing Nix..."
    curl -sSfL https://artifacts.nixos.org/nix-installer | sh -s -- install --enable-flakes
  fi
  ;;
help | -h | --help)
  usage
  ;;
*)
  usage >&2
  exit 1
  ;;
esac
