#!/bin/sh
set -eu

script_path=$(readlink -f -- "$0")
cd "$(dirname "$script_path")"

do_switch() {
  nh="nh"
  if ! command -v nh >/dev/null 2>&1; then
    nh="nix run nixpkgs#nh --"
  fi
  if [ "$(uname)" = "Darwin" ]; then
    $nh darwin switch . -H "$(hostname -s)"
  else
    $nh os switch . -H "$(hostname -s)"
  fi

  bin_dir="${HOME:?}/.local/bin"
  mkdir -p "$bin_dir"
  # Pass the parent directory so ln treats an existing dotfiles directory as a collision.
  if [ -L "$bin_dir/dotfiles" ]; then
    if [ "$(readlink "$bin_dir/dotfiles")" != "$script_path" ]; then
      ln -sfn -- "$script_path" "$bin_dir/"
    fi
  else
    ln -s -- "$script_path" "$bin_dir/"
  fi
}

usage() {
  cat <<EOF
Usage: dotfiles <command>

Commands:
  switch       Apply this flake to the current host
  update       Pull latest changes and switch
  write-flake  Regenerate flake.nix
  install-nix  Install Nix with flakes enabled (macOS only)
EOF
}

case "${1:-}" in
switch)
  do_switch
  ;;
update)
  git checkout main
  git pull
  do_switch
  ;;
write-flake)
  nix run .#write-flake
  ;;
install-nix)
  if [ "$(uname)" != "Darwin" ]; then
    echo "install-nix is only supported on macOS."
    exit 0
  fi
  if command -v nix >/dev/null 2>&1; then
    echo "Nix is already installed."
  else
    echo "Installing Nix..."
    curl -sSfL https://artifacts.nixos.org/nix-installer | sh -s -- install --enable-flakes
  fi
  ;;
help | -h | --help)
  usage
  ;;
*)
  usage >&2
  exit 1
  ;;
esac
